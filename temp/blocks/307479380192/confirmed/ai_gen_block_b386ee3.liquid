{% doc %}
  @prompt
    contdown timer block need 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-timer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-countdown-timer__heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-countdown-timer__subtext-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.subtext_spacing }}px;
    color: {{ block.settings.subtext_color }};
    font-size: {{ block.settings.subtext_size }}px;
    line-height: 1.4;
  }

  .ai-countdown-timer__display-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.text_alignment }};
    gap: {{ block.settings.timer_gap }}px;
    flex-wrap: wrap;
  }

  .ai-countdown-timer__unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: {{ block.settings.unit_min_width }}px;
  }

  .ai-countdown-timer__value-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    color: {{ block.settings.number_color }};
    line-height: 1;
    margin-bottom: {{ block.settings.label_spacing }}px;
  }

  .ai-countdown-timer__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    text-transform: {{ block.settings.label_text_transform }};
  }

  .ai-countdown-timer__expired-{{ ai_gen_id }} {
    display: none;
    color: {{ block.settings.expired_text_color }};
    font-size: {{ block.settings.expired_text_size }}px;
  }

  .ai-countdown-timer__expired-{{ ai_gen_id }}.active {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-timer-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-countdown-timer__display-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }}
  class="ai-countdown-timer-{{ ai_gen_id }}"
  data-end-date="{{ block.settings.end_date }}"
  data-end-time="{{ block.settings.end_time }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-countdown-timer__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.subtext != blank %}
    <div class="ai-countdown-timer__subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>
  {% endif %}

  <div class="ai-countdown-timer__display-{{ ai_gen_id }}">
    {% if block.settings.show_days %}
      <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
        <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-unit="days">00</div>
        <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.label_days }}</div>
      </div>
    {% endif %}

    {% if block.settings.show_hours %}
      <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
        <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-unit="hours">00</div>
        <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.label_hours }}</div>
      </div>
    {% endif %}

    {% if block.settings.show_minutes %}
      <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
        <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-unit="minutes">00</div>
        <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.label_minutes }}</div>
      </div>
    {% endif %}

    {% if block.settings.show_seconds %}
      <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
        <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-unit="seconds">00</div>
        <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.label_seconds }}</div>
      </div>
    {% endif %}
  </div>

  <div class="ai-countdown-timer__expired-{{ ai_gen_id }}">
    {{ block.settings.expired_message }}
  </div>
</countdown-timer-{{ ai_gen_id }}>

<script>
  (function() {
    class CountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.endDate = this.dataset.endDate;
        this.endTime = this.dataset.endTime;
        this.interval = null;
      }

      connectedCallback() {
        if (!this.endDate || !this.endTime) {
          return;
        }

        const endDateTime = new Date(this.endDate + 'T' + this.endTime);
        
        if (isNaN(endDateTime.getTime())) {
          return;
        }

        this.updateCountdown(endDateTime);
        this.interval = setInterval(() => this.updateCountdown(endDateTime), 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      updateCountdown(endDateTime) {
        const now = new Date().getTime();
        const distance = endDateTime.getTime() - now;

        if (distance < 0) {
          this.handleExpired();
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.updateDisplay('days', days);
        this.updateDisplay('hours', hours);
        this.updateDisplay('minutes', minutes);
        this.updateDisplay('seconds', seconds);
      }

      updateDisplay(unit, value) {
        const element = this.querySelector('[data-unit="' + unit + '"]');
        if (element) {
          element.textContent = String(value).padStart(2, '0');
        }
      }

      handleExpired() {
        if (this.interval) {
          clearInterval(this.interval);
        }

        const display = this.querySelector('.ai-countdown-timer__display-{{ ai_gen_id }}');
        const expiredMessage = this.querySelector('.ai-countdown-timer__expired-{{ ai_gen_id }}');

        if (display) {
          display.style.display = 'none';
        }

        if (expiredMessage) {
          expiredMessage.classList.add('active');
        }
      }
    }

    customElements.define('countdown-timer-{{ ai_gen_id }}', CountdownTimer{{ ai_gen_id }});
  })();
</script>

